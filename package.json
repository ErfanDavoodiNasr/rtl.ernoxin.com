{
  "name": "rtl-persian-viewer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 1000 --host",
    "dev:safe": "vite --port 3000 --host",
    "build": "tsc -b && vite build && node scripts/clean-dist.mjs",
    "preview": "vite preview --port 1000 --host",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:security": "vitest run src/utils/urlSafety.test.ts src/utils/svgSanitize.test.ts src/components/MarkdownPreview.security.test.tsx src/utils/exportUtils.test.ts",
    "test:rendering": "vitest run src/utils/renderingFixtures.test.ts src/utils/markdownUtils.test.ts src/utils/bidiUtils.test.ts",
    "test:exports": "vitest run src/utils/exportUtils.test.ts && playwright test e2e/editor-pdf.spec.ts --project=chromium",
    "test:integration": "vitest run src/utils/historyStore.test.ts src/utils/clipboardInsert.test.ts src/utils/storageUtils.test.ts src/utils/exportUtils.test.ts",
    "test:release": "npm run lint && npm run typecheck && npm run test:coverage && npm run test:security && npm run test:rendering && npm run build && npm run test:e2e -- --project=chromium --project=firefox --project=mobile",
    "og-image": "node scripts/generate-og-image.mjs"
  },
  "dependencies": {
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/cairo": "^5.3.0",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/scheherazade-new": "^5.3.0",
    "@fontsource/vazirmatn": "^5.2.8",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "katex": "0.16.47",
    "mermaid": "^11.16.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@playwright/test": "^1.63.0",
    "@types/d3": "^7.4.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "jsdom": "^26.1.0",
    "sharp": "^0.34.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.1"
  },
  "overrides": {
    "katex": "0.16.47"
  }
}
